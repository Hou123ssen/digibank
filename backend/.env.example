APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5174,127.0.0.1,127.0.0.1:5174

BROADCAST_CONNECTION=reverb
BROADCAST_HTTP_CONNECT_TIMEOUT=0.5
BROADCAST_HTTP_TIMEOUT=1.0
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
RUN_MIGRATIONS=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=digibank-local
REVERB_APP_KEY=digibank-local-key
REVERB_APP_SECRET=digibank-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

CIN_AI_SERVICE_URL=http://127.0.0.1:8010
CIN_AI_SERVICE_TIMEOUT=30
TESSERACT_EXECUTABLE="C:/Program Files/Tesseract-OCR/tesseract.exe"
TESSDATA_PREFIX="C:/Users/houss/Desktop/system_bank/tessdata"
TESSERACT_LANGUAGES=fra+ara

PAYMENT_GATEWAY_MODE=sandbox
PAYMENT_GATEWAY_WEBHOOK_SECRET=digibank-sandbox-webhook-secret
PAYMENT_GATEWAY_RETURN_URL=http://localhost:5174/accounts
PAYMENT_GATEWAY_MIN_AMOUNT=10
PAYMENT_GATEWAY_MAX_AMOUNT=50000
PAYMENT_GATEWAY_ALLOW_SANDBOX_CONFIRMATION=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=mad

